>D
;============================================================
; GASZÄHLER-SCRIPT
;============================================================

; --- EINSTELLUNGEN (Hier anpassen) ---
; Impuls-Faktor:
; 100 = 0,01 m³/Imp | 10  = 0,1 m³/Imp | 1  = 1,0 m³/Imp
factor=100

; Startwert des mechanischen Zählers (z.B. 36489.08)
; Hinweis: Ohne Komma eingeben
zaehler_start=0

; GPIO des Impuls-Eingangs (Reedkontakt):
; steht in der >M Sektion und wird beim Laden des Scripts von der
; Firmware automatisch passend zum Chip eingesetzt
; (ESP8266/D1 mini = 14/D5, ESP32-C3 = 4).

; --- INTERNE VARIABLEN (Nicht ändern) ---
>B
=>sensor53 r
=>sensor53 c1 %zaehler_start%

>M 1
+1,%GPIO%,c,1,-500,Gas
1,1-0:1.8.0*255(@%factor%,Gesamtverbrauch,m³,total,2)
